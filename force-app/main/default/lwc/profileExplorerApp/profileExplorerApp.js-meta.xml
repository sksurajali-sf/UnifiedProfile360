<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Unified Profile 360</masterLabel>
    <description>Search unified profiles by data space, object and attribute, then open the full Unified Profile 360 view.</description>
    <targets>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage">
            <property
                name="headerTitle"
                type="String"
                label="Header title"
                default="Unified Profile 360"
            />
            <property
                name="insightApiNames"
                type="String"
                label="Calculated insight API names"
                description="Comma separated __cio API names to offer in the insight picker."
                default="Lifetime_Purchase_Count__cio,Total_Visits__cio,Cg_Monthly_Count__cio"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
