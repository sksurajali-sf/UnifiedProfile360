<!--
  See dcProfileHeader for why each panel has its own shell.
-->
<aura:component
    implements="flexipage:availableForAllPageTypes,force:hasRecordId,force:hasSObjectName"
    access="global"
    description="Orders across every source individual, with value derived from line items."
>
    <aura:attribute name="recordId" type="String" access="global" />
    <aura:attribute name="sObjectName" type="String" access="global" />

    <aura:attribute name="maxRows" type="Integer" default="25" access="global" />
    <aura:attribute name="initialRows" type="Integer" default="10" access="global" />

    <c:unifiedOrderTimeline
        recordId="{!v.recordId}"
        objectApiName="{!v.sObjectName}"
        maxRows="{!v.maxRows}"
        initialRows="{!v.initialRows}"
    />
</aura:component>
