<!--
  LWC cannot target a CDP record page, so each panel is exposed there through its own thin
  Aura shell. One shell per panel keeps them independently placeable in App Builder, and
  keeps the design surface empty here, since design attributes can never be removed once
  a component implements a Lightning page interface.
-->
<aura:component
    implements="flexipage:availableForAllPageTypes,force:hasRecordId,force:hasSObjectName"
    access="global"
    description="Reconciled winner values for the unified profile."
>
    <aura:attribute name="recordId" type="String" access="global" />
    <aura:attribute name="sObjectName" type="String" access="global" />

    <c:unifiedProfileHeader recordId="{!v.recordId}" objectApiName="{!v.sObjectName}" />
</aura:component>
