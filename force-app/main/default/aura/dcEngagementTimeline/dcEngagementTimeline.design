<design:component label="Unified Engagement Timeline">
    <design:attribute
        name="maxRows"
        label="Maximum events fetched"
        description="Upper bound on events read per channel. Lower values load faster."
    />
    <design:attribute
        name="initialRows"
        label="Events shown before expanding"
        description="Rows visible on load. The rest appear behind a Show more control."
    />
</design:component>
