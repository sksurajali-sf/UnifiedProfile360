<!--
  The whole profile page as a single drop, and the only component this package puts in the
  App Builder palette. A CDP record page region is one column wide, so the side-by-side
  arrangement has to come from inside the component rather than from the page.

  An Aura shell is needed at all because a Lightning web component cannot target a CDP record
  page; this one exists purely to hand recordId and sObjectName through to the LWC.
-->
<aura:component
    implements="flexipage:availableForAllPageTypes,force:hasRecordId,force:hasSObjectName"
    access="global"
    description="Complete unified profile: header, identity breakdown and insights beside the timelines."
>
    <aura:attribute name="recordId" type="String" access="global" />
    <aura:attribute name="sObjectName" type="String" access="global" />

    <c:unifiedProfileView recordId="{!v.recordId}" objectApiName="{!v.sObjectName}" />
</aura:component>
